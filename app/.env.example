# zhixu-store 前端构建期环境变量示例。
# 复制为 .env.local（或部署环境的等价注入方式）后按部署填写；
# 缺必填项时对应功能 fail-closed 显式失败，不回落到假可用状态。

# Chain Services 地址（必填）：目录、订单工作台与治理读写的 API base URL。
VITE_UVP_CHAIN_SERVICES_URL=http://127.0.0.1:8787

# uvp-order-app 部署地址（参与方邀请链接必填）：?invite=&inviteToken= 的消费
# 逻辑只存在于 uvp-order-app，本站不读这组参数。缺配置时邀请链接 fail-closed
# 拒绝生成（避免产出死链并外泄一次性令牌），发邀请本身不受影响。
VITE_UVP_ORDER_APP_URL=https://order-app.example.com

# 状态机部署地址（签名必填）：签名域交叉核对的预期值，来自部署配置注入而非
# 被核对的同一 BFF 响应。缺配置或格式非法时拒绝签名。
VITE_UVP_STATE_MACHINE_ADDRESS=0x0000000000000000000000000000000000000000

# 本地开发访问级别（可选）：缺省 anonymous_read；运行时不认 query 注入。
# VITE_UVP_STORE_ACCESS_LEVEL=store_operator
# VITE_UVP_STORE_USER_ID=

# 读/写超时（毫秒，可选）：缺省 6000；证据上传单独放宽（缺省 60000）。
# VITE_UVP_STORE_FETCH_TIMEOUT_MS=6000
# VITE_UVP_WORKBENCH_FETCH_TIMEOUT_MS=6000
# VITE_UVP_WORKBENCH_UPLOAD_TIMEOUT_MS=60000
